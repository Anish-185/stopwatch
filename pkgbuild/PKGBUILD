pkgname=stopwatch
pkgver=0.1.0
pkgrel=1
pkgdesc='A count-up stopwatch you can start from any time'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/stopwatch "$pkgdir/usr/bin/stopwatch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/stopwatch.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/stopwatch.svg"
  install -Dm644 "$startdir/stopwatch.desktop" "$pkgdir/usr/share/applications/stopwatch.desktop"
}
